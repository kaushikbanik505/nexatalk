PORT=5001
NODE_ENV=development

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexatalk

JWT_SECRET_KEY=a_long_random_string

CLIENT_URL=http://localhost:5173

# The account with this email is auto-promoted to role "admin" on its next request/login
ADMIN_EMAIL=your_admin_account@example.com

# Stream (chat + video) - same app as VITE_STREAM_API_KEY in frontend/.env.example
STEAM_API_KEY=your_stream_api_key
STEAM_API_SECRET=your_stream_api_secret

# Free key from https://aistudio.google.com/apikey - powers the mascot's AI buddy chat
GEMINI_API_KEY=your_gemini_api_key
